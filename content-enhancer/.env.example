# Backend API Configuration (Phase 1 - Node.js)
BACKEND_API_BASE_URL=http://localhost:8000/api

# LLM Configuration (Choose one)

# Option 1: Google Gemini (FREE - no credit card needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL_GEMINI=gemini-2.0-flash

# Option 2: Ollama (FREE - runs locally)
# LLM_PROVIDER=ollama
# LLM_MODEL_OLLAMA=mistral
# OLLAMA_BASE_URL=http://localhost:11434

# Option 3: OpenAI (Paid - $5 free trial)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL_OPENAI=gpt-3.5-turbo

# Google Search Configuration (Optional)
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id-here

# Scraper Configuration
BATCH_SIZE=1
DELAY_BETWEEN_REQUESTS=2000
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
EXCLUDE_DOMAINS=beyondchats.com

# Processing
BATCH_SIZE=1
DELAY_BETWEEN_REQUESTS=2000

# Logging
LOG_LEVEL=info
NODE_ENV=development
